# ═════════════════════════════════════════════════════════════════════════════
# PoliticOS — Variables de entorno para el backend en RENDER (demo)
#
# Cómo usar: copia estos valores en Render → tu servicio → Environment.
# Si usaste render.yaml (Blueprint), Render ya pre-creó las claves; aquí
# solo rellenas las marcadas como (SECRETO / RELLENAR).
#
# Demo = single-tenant, SIN Redis, SIN servicio Python de ingesta.
# ═════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=PoliticOS
APP_ENV=production
APP_DEBUG=false                   # NUNCA true en una URL pública

# (RELLENAR) Generar en tu máquina local, dentro del repo:
#   php artisan key:generate --show
# y pegar el resultado completo (empieza con "base64:").
APP_KEY=

# (RELLENAR) URL pública del servicio en Render (la ves al crear el servicio).
# La usa Laravel para construir URLs de media (/storage/...).
# Si la dejas vacía, el entrypoint usa RENDER_EXTERNAL_URL automáticamente.
APP_URL=https://politicos-api.onrender.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# ── Logs (a stderr → visibles en Render → Logs) ──────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ── Multi-tenancy — demo single-tenant sin subdominios ───────────────────────
# ResolveTenant usa config('app.tenant_slug') cuando no hay subdominio.
# Debe ser el slug que creaste con `php artisan tenant:provision` (Parte A
# de DEPLOY-DEMO.md). Si lo dejas VACÍO, la app corre directo sobre
# DB_DATABASE sin buscar en la tabla tenants (modo ultra simple, 1 schema).
APP_TENANT_SLUG=demo

# ── Base de datos — MySQL 8 en RAILWAY ───────────────────────────────────────
# Railway → tu servicio MySQL → pestaña "Connect" / "Variables":
#   MYSQLHOST / MYSQLPORT / MYSQLUSER / MYSQLPASSWORD / MYSQLDATABASE
# Usa el host/puerto PÚBLICOS (proxy.rlwy.net:XXXXX), no el interno.
#
# IMPORTANTE: DB_DATABASE es el schema CENTRAL (tabla tenants, plan_features).
# La conexión 'central' de config/database.php lee ESTAS MISMAS variables
# (no existe DB_CENTRAL_DATABASE — ver "Notas para el dueño" en DEPLOY-DEMO.md).
# La BD del tenant demo es OTRO schema del mismo server (p.ej. bdpolitic_demo),
# registrado en la tabla tenants por tenant:provision.
DB_CONNECTION=mysql
DB_HOST=                          # (SECRETO) p.ej. yamanote.proxy.rlwy.net
DB_PORT=                          # (SECRETO) puerto público de Railway, p.ej. 34567
DB_DATABASE=railway               # schema central (Railway crea "railway" por defecto)
DB_USERNAME=root                  # (SECRETO)
DB_PASSWORD=                      # (SECRETO) Railway → MYSQLPASSWORD

# ── SIN Redis (demo) ──────────────────────────────────────────────────────────
# Colas inline (los jobs GenerateAlerts/Cluster/etc. corren al momento o no
# corren — la inteligencia electoral queda en pausa sin el ingest de todos modos).
QUEUE_CONNECTION=sync
# Cache en archivos del contenedor (suficiente para demo de 1 instancia).
CACHE_STORE=file
# Sesiones en la tabla `sessions` (la crea la migración base 0001).
SESSION_DRIVER=database
SESSION_LIFETIME=120

# ── CORS / Sanctum (según config/cors.php REAL del repo) ─────────────────────
# config/cors.php mete env('FRONTEND_URL') en allowed_origins (match EXACTO:
# con https:// y SIN slash final) y env('CORS_ALLOWED_PATTERN') en
# allowed_origins_patterns (regex de preg_match: CON delimitadores #...#).
FRONTEND_URL=https://tu-proyecto.vercel.app
SANCTUM_STATEFUL_DOMAINS=tu-proyecto.vercel.app
# Opcional — cubre también los preview-deploys de Vercel:
# CORS_ALLOWED_PATTERN=#^https://[a-z0-9-]+\.vercel\.app$#

# ── IA — proveedor del chat (configurable por tenant en AiSetting) ───────────
AI_PROVIDER=claude                # claude | openai | groq
ANTHROPIC_API_KEY=                # (SECRETO) sk-ant-... → console.anthropic.com
CLAUDE_MODEL=claude-haiku-4-5-20251001
GROQ_API_KEY=                     # (SECRETO, opcional) gsk_... → console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=                   # (SECRETO, opcional) fallback
OPENAI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=600

# ── RAG — FULLTEXT de MySQL (sin Qdrant en la demo) ──────────────────────────
# Por esto la BD DEBE ser MySQL 8 real (MATCH ... AGAINST), no Postgres.
AI_EMBEDDINGS_DRIVER=mysql_fulltext

# ── Storage de media ──────────────────────────────────────────────────────────
# "public" = storage/app/public del contenedor de Render → SE BORRA en cada
# redeploy/reinicio (disco efímero, incluso en planes de pago sin volumen
# montado). Confirmado en producción: videos/fotos subidos en hero_settings y
# hero_media desaparecían tras el siguiente deploy. Fix: Cloudflare R2
# (S3-compatible, sin costo de egreso, capa gratis 10GB) — mismo código,
# solo cambian estas variables:
FILESYSTEM_DISK=local
MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=                # (SECRETO) R2 → Manage API tokens → Create
AWS_SECRET_ACCESS_KEY=            # (SECRETO) se muestra una sola vez al crear el token
AWS_DEFAULT_REGION=auto           # R2 usa "auto", no una región real de AWS
AWS_BUCKET=politicos-media
AWS_ENDPOINT=                     # https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true  # requerido por R2
AWS_URL=                          # https://pub-xxxxxxxx.r2.dev (bucket → Settings → Public Access)
#
# Si vuelves a MEDIA_DISK=public (no recomendado en Render): los archivos
# nuevos se guardan local otra vez y se pierden en el próximo deploy.

# ── Claves internas ───────────────────────────────────────────────────────────
# (SECRETO) Acceso a /api/superadmin/*. Generar: openssl rand -hex 32
SUPER_ADMIN_KEY=
# (SECRETO) Auth del servicio Python de ingesta — APAGADO en la demo, pero la
# ruta /api/admin/external-signals/ingest existe: pon una key aleatoria fuerte
# igual. Generar: openssl rand -hex 32
INGEST_KEY=

# ── Control del entrypoint del contenedor ─────────────────────────────────────
RUN_MIGRATIONS=true               # migra en cada arranque (idempotente)
RUN_SEED=false                    # "true" SOLO en el primer deploy del schema central

# ── Mail / broadcast (demo) ───────────────────────────────────────────────────
MAIL_MAILER=log
BROADCAST_CONNECTION=log
